{
  "name": "@withnative/mcp-stdio",
  "version": "0.1.0",
  "description": "Pinned stdio compatibility adapter for Native's hosted MCP service",
  "license": "MPL-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": {
    "mcp-stdio": "dist/bin/mcp-stdio.js",
    "mcp-stdio-auth": "dist/bin/mcp-stdio-auth.js"
  },
  "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/withnative/plugins.git",
    "directory": "packages/mcp-stdio"
  },
  "homepage": "https://github.com/withnative/plugins/tree/main/packages/mcp-stdio",
  "bugs": { "url": "https://github.com/withnative/plugins/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && vitest run",
    "test:pack": "npm run build && node scripts/pack-smoke.mjs",
    "check": "npm test && npm run test:pack",
    "prepack": "npm run build"
  },
  "dependencies": { "mcp-remote": "0.1.38" },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
